[Unit]
Description=Aegis Security Suite Web Dashboard
Documentation=https://github.com/aegis-security-suite/web-dashboard
After=network.target
Wants=network.target

[Service]
Type=simple
User=${CURRENT_USER}
WorkingDirectory=${AEGIS_HOME}/web-dashboard
Environment=AEGIS_HOME=${AEGIS_HOME}
Environment=FLASK_ENV=production
Environment=FLASK_APP=app.py
Environment=PYTHONPATH=${AEGIS_HOME}/web-dashboard
ExecStart=${AEGIS_HOME}/web-dashboard/venv/bin/python3 ${AEGIS_HOME}/web-dashboard/app.py
ExecReload=/bin/kill -HUP $MAINPID
KillMode=mixed
TimeoutStopSec=30
PrivateTmp=true
Restart=on-failure
RestartSec=10

# Security settings
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=${AEGIS_HOME}/configs
ReadWritePaths=${AEGIS_HOME}/logs
ReadWritePaths=/tmp
ReadWritePaths=${AEGIS_HOME}/web-dashboard

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aegis-dashboard

[Install]
WantedBy=default.target
Alias=aegis-dashboard.service