[Unit]
Description=Aegis Security Suite Behavioral Monitor
Documentation=https://github.com/aegis-security-suite/behavioral-analysis
After=network.target
Wants=network.target

[Service]
Type=simple
User=${CURRENT_USER}
Environment=AEGIS_HOME=${AEGIS_HOME}
WorkingDirectory=${AEGIS_HOME}/scripts
ExecStart=${AEGIS_HOME}/scripts/behavioral-monitor.sh
ExecReload=/bin/kill -HUP $MAINPID
KillMode=mixed
TimeoutStopSec=10
Restart=on-failure
RestartSec=30

# Security settings
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=${AEGIS_HOME}/configs
ReadWritePaths=${AEGIS_HOME}/logs
ReadWritePaths=${AEGIS_HOME}/evidence
ReadWritePaths=${AEGIS_HOME}/quarantine
ReadWritePaths=/tmp

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aegis-behavioral-monitor

[Install]
WantedBy=default.target